# Copy to .env.local for local development (never commit real keys).
# Values from `npx supabase start` locally, or Project Settings → API in the dashboard.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Minutes of inactivity before automatic sign-out (default 15)
VITE_IDLE_MINUTES=15
